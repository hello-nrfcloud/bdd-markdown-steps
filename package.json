{
  "name": "@hello.nrfcloud.com/bdd-markdown-steps",
  "version": "0.0.0-development",
  "description": "Step definitions for BDD Markdown",
  "exports": {
    "./*": {
      "import": {
        "types": "./src/*.ts",
        "default": "./npm/*.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --no-warnings --test \"!(npm|node_modules)/**/*.spec.ts\"",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "prepublishOnly": "node --experimental-transform-types --no-warnings ./.npm/compile.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/bdd-markdown-steps.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/bdd-markdown-steps/issues"
  },
  "homepage": "https://github.com/hello-nrfcloud/bdd-markdown-steps",
  "keywords": [
    "bdd",
    "steps",
    "typescript"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "7.0.34",
    "@bifravst/prettier-config": "1.1.17",
    "@commitlint/config-conventional": "21.2.2",
    "@swc/core": "1.15.47",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "26.2.0",
    "@types/toposort": "2.0.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "nock": "14.0.17",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm",
    "src",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config",
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1110.0",
    "@bifravst/bdd-markdown": "^9.0.0",
    "@bifravst/http-api-mock": "^2.1.465",
    "@hello.nrfcloud.com/nrfcloud-api-helpers": "^6.1.0-dev.1",
    "@sinclair/typebox": "^0.34.52",
    "jsonata": "^2.2.2",
    "p-retry": "^8.0.0"
  }
}
